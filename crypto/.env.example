# === Sales bot (apps/api) — Telegram bot that sells course tiers ===
TELEGRAM_BOT_TOKEN=

# === Admin identity — single source of truth, lives in Mongo (apps/api) ===
# Seed account: created/updated on API boot from these two values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared JWT secret — apps/api issues the token, apps/bot verifies the same one.
JWT_SECRET=

# === Mongo (apps/api) ===
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_URI=mongodb://<user>:<password>@mongo:27017/crypto?authSource=admin

# === Ports ===
API_PORT=3031
WEB_PORT=3030
ADMIN_PORT=3032
BOT_PORT=3033
BOT_WEBHOOK_PORT=3034

# Used by the web app server-side to reach the API inside the docker network
API_INTERNAL_URL=http://api:3031

# Used by the admin app (browser-side) to reach each independent API
NEXT_PUBLIC_API_URL=http://localhost:3031
NEXT_PUBLIC_BOT_API_URL=http://localhost:3033

# === Channel bot (apps/bot) — generates + posts daily content to a Telegram channel ===
CHANNEL_BOT_TOKEN=                     # token from @BotFather
CHANNEL_ID=                            # target channel id (bot must be admin there)
OWNER_ID=                              # your Telegram user id — alerts go here

# Network mode for the channel bot itself (separate from the admin API port above).
# polling (default) — no public URL needed.
# webhook — needs a public HTTPS URL (tunnel in dev, real domain in prod).
BOT_MODE=polling
WEBHOOK_URL=                           # e.g. https://your-tunnel-or-domain.example
WEBHOOK_PATH=/telegram/webhook

# OpenAI (post generation)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Post prompt template (edit here, no code change needed)
PROMPT_TEMPLATE="Ти — редактор криптовалютного телеграм-каналу. Напиши короткий (800-1200 символів) допис українською про поточні тренди/новини у світі криптовалют. Тон: впевнений, без фінансових порад, без клікбейту. Додай 1-2 доречні емодзі. Без хештегів."

# Daily trigger schedule (only used on first run, before there's state in the DB)
DAILY_HOUR=9
DAILY_MINUTE=0

# Channel bot's own DB (SQLite via Prisma, path relative to apps/bot/prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Link to the unified admin's "Канал-бот" tab, used in Telegram owner alerts
BOT_PANEL_URL=
