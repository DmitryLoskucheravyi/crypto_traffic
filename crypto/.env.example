# === Telegram-бот (apps/api) — продаёт курсы и выдаёт материалы ===
TELEGRAM_BOT_TOKEN=

# === Оплата: USDT в сети TRON (TRC20) ===
# Кошелёк, на который принимаем платежи. Пока не задан — бот работает, но
# счёт выставить не сможет и скажет об этом прямо.
TRON_WALLET_ADDRESS=
# Ключ TronGrid (https://www.trongrid.io). Без него слушатель кошелька выключен.
TRONGRID_API_KEY=
TRON_API_URL=https://api.trongrid.io
# Контракт USDT в TRON — менять нужно только под другой токен.
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Как часто опрашивать кошелёк (мс). Меньше 5000 игнорируется.
PAYMENT_POLL_INTERVAL_MS=20000
# Сколько минут действует выставленная сумма, прежде чем освободится.
PAYMENT_TTL_MINUTES=60

# === Выдача материалов после оплаты ===
# Для каждого уровня одно из трёх: путь к файлу, ссылка или telegram file_id.
# Пусто — бот сообщит, что материалы пришлёт менеджер.
#
# Путь считается от корня crypto/ (в контейнере — от /app, туда монтируется
# ./materials). Саму папку materials/ в git не кладём: репозиторий публичный,
# а это платный продукт — файлы живут на сервере.
COURSE_MATERIAL_BASIC=
COURSE_MATERIAL_MEDIUM=
COURSE_MATERIAL_ADVANCED=

# === Mongo (apps/api) — хранит только заказы ===
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_URI=mongodb://<user>:<password>@mongo:27017/crypto?authSource=admin

# === Лендинг (apps/web) ===
# Публичный адрес сайта без слеша на конце, например https://cryptospheere.com
# Из него собираются <link rel="canonical">, sitemap.xml, robots.txt и
# абсолютная ссылка на og:image для превью в соцсетях и мессенджерах.
# Пусто — сборка уйдёт с http://localhost:3030 внутри, и поисковики
# увидят чужой адрес вместо вашего.
NEXT_PUBLIC_SITE_URL=

# Ссылки в футере. Везде достаточно имени — @ и целый адрес тоже примутся
# («courses», «@courses» и «https://t.me/courses» равнозначны).
#
# Бот, через которого идёт продажа. Пусто — останется встроенное значение
# crypto_course_sell_bot, и все кнопки лендинга поведут туда.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Канал с контентом — это не бот. Пусто — иконки канала в футере просто нет.
# Пригласительная ссылка закрытого канала (t.me/+AbCdEf) тоже годится.
NEXT_PUBLIC_TELEGRAM_CHANNEL_USERNAME=
# Instagram-аккаунт. Пусто — встроенный crypt0_spheere.
NEXT_PUBLIC_INSTAGRAM_USERNAME=

# === Порты ===
API_PORT=3031
WEB_PORT=3030
