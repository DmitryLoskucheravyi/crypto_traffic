# Telegram (бот тут лише публікує в канал і шле алерти власнику — керування через веб-панель)
BOT_TOKEN=123456:ABC-DEF...            # токен від @BotFather
CHANNEL_ID=-1001234567890              # id цільового каналу (бот має бути адміном)
OWNER_ID=123456789                     # твій telegram user id — куди слати алерти/сповіщення

# Мережевий режим бота
# polling (за замовчуванням) — нічого додатково не треба, працює без публічного URL
# webhook — треба публічний HTTPS URL (в dev — тунель на кшталт cloudflared/ngrok, в проді — домен/Docker).
# Це ОКРЕМИЙ порт від веб-панелі нижче — telegraf піднімає свій внутрішній http-сервер.
BOT_MODE=polling
WEBHOOK_URL=                           # напр. https://your-tunnel-or-domain.example
WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_PORT=3001

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Промпт-шаблон генерації допису (редагується тут, без зміни коду)
PROMPT_TEMPLATE="Ти — редактор криптовалютного телеграм-каналу. Напиши короткий (800-1200 символів) допис українською про поточні тренди/новини у світі криптовалют. Тон: впевнений, без фінансових порад, без клікбейту. Додай 1-2 доречні емодзі. Без хештегів."

# Розклад щоденного тригера (використовується лише при першому запуску, поки немає стану в БД)
DAILY_HOUR=9
DAILY_MINUTE=0

# База даних (шлях відносно prisma/schema.prisma, тобто файл буде prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Веб-панель адміністрування (повна заміна Telegram-команд — сюди заходиш логіном/паролем)
PANEL_PORT=3000
PANEL_URL=                             # напр. https://panel.example.com — використовується у Telegram-алертах як лінк і для secure-cookie
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please        # мінімум 8 символів
SESSION_SECRET=change-me-too-please-32chars-min
